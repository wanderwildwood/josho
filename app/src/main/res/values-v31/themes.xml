<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 (the Kompakt) draws a splash screen whether or not an app asks; this one draws
         nothing, a transparent icon on white. Android 11 (the Supernotes) has none to turn off. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_nothing</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
